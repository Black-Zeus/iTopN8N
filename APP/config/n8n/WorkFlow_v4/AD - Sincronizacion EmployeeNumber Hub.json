    {
      "parameters": {
        "operation": "search",
        "baseDN": "DC=GFPE,DC=GFIROOT,DC=Local",
        "searchFor": "custom",
        "customFilter": "(&(objectClass=user)(objectCategory=person)(sAMAccountName=*))",
        "returnAll": true,
        "options": {
          "attributes": ["sAMAccountName", "displayName", "employeeNumber", "distinguishedName", "userAccountControl"],
          "pageSize": 1000,
          "scope": "sub"
        }
      },
      "type": "n8n-nodes-base.ldap",
      "typeVersion": 1,
      "position": [256, 80],
      "id": "16a85657-e70d-46d0-b10a-b21f68c97b21",
      "name": "LDAP - Leer EmployeeNumber",
      "credentials": {
        "ldap": {
          "id": "LDAPGFEmployeeSync",
          "name": "LDAP_GF"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "function clean(value) {\n  if (Array.isArray(value)) value = value[0];\n  return String(value ?? '').trim();\n}\n\nconst output = [];\nconst seen = new Set();\nfor (const item of $input.all()) {\n  const row = item.json || {};\n  const userId = clean(row.sAMAccountName ?? row.samaccountname).toLowerCase();\n  const displayName = clean(row.displayName ?? row.displayname);\n  const employeeNumber = clean(row.employeeNumber ?? row.employeenumber);\n  const distinguishedName = clean(row.distinguishedName ?? row.dn);\n  const userAccountControl = Number(clean(row.userAccountControl ?? row.useraccountcontrol) || 0);\n  const isActive = (userAccountControl & 2) === 0 ? 1 : 0;\n  if (!userId || seen.has(userId)) continue;\n  seen.add(userId);\n  output.push({ json: { user_id: userId, display_name: displayName, employee_number: employeeNumber, distinguished_name: distinguishedName, is_active: isActive } });\n}\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [512, 80],
      "id": "f031aa35-8855-4ee9-a68d-8f8b44625255",
      "name": "Normalizar y validar"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO hub_ad_employee_numbers (user_id, display_name, employee_number, distinguished_name, is_active, synced_at) VALUES ($1, $2, $3, $4, $5, NOW()) ON DUPLICATE KEY UPDATE display_name = VALUES(display_name), employee_number = VALUES(employee_number), distinguished_name = VALUES(distinguished_name), is_active = VALUES(is_active), synced_at = VALUES(synced_at)",
        "options": {
          "queryBatching": "transaction",
          "queryReplacement": "={{ [$json.user_id, $json.display_name, $json.employee_number, $json.distinguished_name, $json.is_active] }}"
        }
      },
      "type": "n8n-nodes-base.mySql",
